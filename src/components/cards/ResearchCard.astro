---
import CardMark from '@components/ui/CardMark.astro';
import Icon from '@components/ui/Icon.astro';
import { logoSrc, site } from '@lib/content';
import { youtubeId } from '@lib/youtube';

interface Props {
  icon?: string;
  venue: string;
  title: string;
  description?: string;
  href?: string;
  youtube?: string;
  image?: string;
  logo?: string;
  variant?: 'default' | 'stacked';
  logoBadge?: boolean;
  featured?: boolean;
}
const {
  icon,
  venue,
  title,
  description,
  href,
  youtube,
  image,
  logo,
  variant = 'default',
  logoBadge: logoBadgeOverride,
  featured = false,
} = Astro.props;
const isStacked = variant === 'stacked';

const ytId = youtubeId(youtube);
const ytEmbed = ytId ? `https://www.youtube-nocookie.com/embed/${ytId}` : null;
const logoUrl = logoSrc(logo);
const { common } = site.ui;
---

<article
  class:list={[
    'rcard',
    'content-card',
    'card-accent',
    'reveal',
    { 'rcard--stacked': isStacked },
    { 'rcard--featured': featured },
    { 'reveal--clip': featured },
  ]}
>
  {
    logoUrl ? (
      <CardMark
        slug={logo}
        logoUrl={logoUrl}
        altText={venue}
        useBadge={logoBadgeOverride}
        class="rcard-logo"
      />
    ) : (
      <CardMark
        icon={icon}
        iconFallback="document"
        variant="accented"
        class="rcard-logo"
      />
    )
  }
  {isStacked && <hr class="rcard-divider" aria-hidden="true" />}
  {!isStacked && <div class="venue">{venue}</div>}
  {
    href ? (
      <h3>
        <a href={href} target="_blank" rel="noopener noreferrer">
          {title}
          <Icon name="external" size="sm" />
          <span class="visually-hidden">{common.opensInNewWindow}</span>
        </a>
      </h3>
    ) : (
      <h3>{title}</h3>
    )
  }
  {
    isStacked && (
      <>
        <div class="venue venue--stacked">{venue}</div>
        {description && <hr class="rcard-divider" aria-hidden="true" />}
      </>
    )
  }
  {
    image && (
      <div class="rcard-media">
        <img
          src={image}
          alt={`${venue} — ${title}`}
          width={640}
          height={360}
          loading="lazy"
        />
      </div>
    )
  }
  {description && <p>{description}</p>}
  {
    ytEmbed && (
      <div class="rcard-video">
        <iframe
          src={ytEmbed}
          title={`${title}${common.videoTitleSuffix}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        />
      </div>
    )
  }
</article>

<style>
  .rcard-logo {
    margin-bottom: var(--text-gap-inline);
  }
  .rcard :global(.icon-tile),
  .rcard :global(.theme-card__icon) {
    margin-bottom: var(--text-gap-inline);
  }
  .rcard--stacked .rcard-logo,
  .rcard--stacked :global(.icon-tile),
  .rcard--stacked :global(.theme-card__icon) {
    align-self: flex-start;
    width: fit-content;
    margin-bottom: 0;
  }
  .rcard--stacked {
    display: flex;
    flex-direction: column;
    gap: var(--text-gap-inline);
  }
  .rcard-divider {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 0;
  }
  .venue {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    /* Follow the per-section accent (publications=blue, conferences=teal) so the
       Research view's multi-color reads on its most prominent label; falls back
       to the static label hue when no section accent is set. */
    color: var(--accent-card, var(--accent-ll));
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    margin-bottom: var(--text-gap-inline);
  }
  .venue--stacked {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: normal;
    text-transform: none;
    margin-bottom: 0;
    margin-top: 0;
  }
  .rcard h3 {
    font-size: var(--fs-card-title-sm);
    font-weight: var(--fw-semibold);
    font-family: var(--font-sans);
    line-height: var(--lh-snug);
    margin-bottom: var(--text-gap-inline);
  }
  .rcard--stacked h3 {
    margin-bottom: 0;
  }
  .rcard h3 a {
    color: var(--heading);
    text-decoration: none;
  }
  .rcard h3 a:hover {
    color: var(--accent-light);
  }
  .rcard h3 a :global(.icon) {
    margin-inline-start: var(--space-1);
  }
  .rcard p {
    font-size: var(--fs-body);
    color: var(--text-muted);
    line-height: var(--lh-relaxed);
    max-width: none;
  }
  .rcard--stacked p {
    margin-bottom: 0;
  }
  .rcard--stacked .rcard-media,
  .rcard--stacked .rcard-video {
    margin: 0;
  }
  .rcard-media,
  .rcard-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: var(--stack-sm) 0 var(--space-3);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--overlay-scrim);
  }
  .rcard-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .rcard-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Featured card - promotes first item in publications to prominence.
     Transitions come from the shared .content-card shell (global.css). */
  .rcard--featured {
    grid-column: 1 / -1;
    box-shadow: var(--shadow-accent);
  }

  .rcard--featured:hover {
    box-shadow: var(--shadow-accent), var(--shadow-md);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rcard--featured:hover {
      transform: translateY(var(--card-lift-lg));
    }
  }

  /* Standard card hover elevation */
  .rcard:not(.rcard--featured):hover {
    box-shadow: var(--shadow-lg);
  }
</style>
