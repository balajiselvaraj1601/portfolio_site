---
// Spreads ...rest onto the root so the parent can attach the data-project
// filter attribute the shared recog-grid behaviour matches against.
import Icon from '@components/ui/Icon.astro';
import { resolveIcon } from '@lib/icons';

interface Bullet {
  text: string;
  tier?: 'primary' | 'secondary';
}
interface Props {
  id: string;
  name: string;
  subtitle?: string;
  icon?: string;
  bullets: Bullet[];
  'data-project'?: string;
}
const { id, name, subtitle, icon, bullets, ...rest } = Astro.props;
const iconName = resolveIcon(icon, 'folder');
---

<article class="xp-proj card" id={id} data-xp-proj {...rest}>
  <header class="xp-proj__head">
    <div
      class="icon-tile icon-tile--compact icon-tile--round icon-tile--accented"
      aria-hidden="true"
    >
      <Icon name={iconName} />
    </div>
    <div class="xp-proj__titles">
      {subtitle && <p class="subhead-kicker">{subtitle}</p>}
      <h3 class="card-title xp-proj__name">{name}</h3>
    </div>
  </header>
  <ul class="bullet-list">
    {
      bullets.map((b) => (
        <li class:list={[{ 'is-secondary': b.tier === 'secondary' }]}>
          {b.text}
        </li>
      ))
    }
  </ul>
</article>

<style>
  .xp-proj {
    /* Subordinate to the role/company anchor above: quieter than the parent
       .card — standard padding (vs the company block's --card-padding-lg). */
    padding: var(--card-padding);
    border-top: 2px solid var(--accent-card, var(--accent));
    display: flex;
    flex-direction: column;
    gap: var(--text-gap-inline);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  /* Toggled by the shared recog-grid filter behaviour (chip selector). */
  .xp-proj.hidden {
    display: none;
  }
  .xp-proj__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .xp-proj__titles {
    display: flex;
    flex-direction: column;
    gap: var(--text-gap-pair);
  }
  .is-secondary {
    color: var(--text-muted);
  }
</style>
